node_modules/
.env

# Сборка и артефакты инструментов — раньше dist/ и tsbuildinfo не
# игнорировались и уезжали в архив проекта (63 МБ вместо ~5 МБ).
dist/
dist-ssr/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Кэш occurrences бэктеста (backtest/occurrence-cache.ts) — производный
# артефакт, восстанавливается повторным прогоном.
backtest/.cache/

# Постраничный кэш сырых свечей (backtest/candle-cache.ts) — тот же принцип:
# производный артефакт, безопасно удаляется, повторный прогон докачает
# недостающие страницы заново.
backtest/.candle-cache/

# Черновик прогресса прогона horizon-audit (backtest/horizon-audit.ts,
# writeProgressCheckpoint) — удаляется автоматически при успешном
# завершении прогона; если остался в дереве, значит прогон прервался.
backtest/output/*.progress.json

# BUGFIX (2026-09-27): backtest/output-run/ — рабочий каталог для
# результатов конкретного диагностического прогона (использовался с
# `--output=backtest/output-run` при разборе бага 4/5 в data-loader.ts), не
# часть постоянной структуры проекта. Раньше случайно попал в коммит
# 464f28f через `git add -A` вместе с ещё не финальным прогоном (165601
# свечей на символ — до фикса бага 5, устарел уже на момент коммита) и
# рисковал быть принятым за актуальный результат при последующем анализе.
# backtest/output/ (без -run) — отдельный, осознанно версионируемый каталог
# с примерами готовых отчётов, его не касается.
backtest/output-run/

# Каталоги сторонних агентов/IDE
.kilo/
.DS_Store
